# README.md / AGENTS.md / LICENSE
# .env.example
# requirements.txt / package.json / lockfiles
# notebooks/*.ipynb
# models/*.md / models/*.json
# reports/*.md / reports/*.csv / reports/*.json
# assets/plots/
# assets/examples/
# assets/screenshots/
# assets/diagrams/
# backend/
# frontend/src/
